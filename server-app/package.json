{
  "name": "onesoft-erp-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs",
    "build": "esbuild src/index.ts --platform=node --bundle --format=esm --outfile=dist/index.mjs --external:pg-native --external:fsevents --log-level=warning",
    "build:check": "node -e \"const f=require('fs');const s=f.statSync('dist/index.mjs');const mb=(s.size/1024/1024).toFixed(1);if(s.size<500000){process.stderr.write('ERROR: dist/index.mjs is too small ('+mb+'MB) — dependencies may not be bundled\\n');process.exit(1);}console.log('OK: dist/index.mjs =',mb,'MB (standalone bundle)')\"",
    "build:full": "pnpm build && pnpm build:check",
    "setup-db": "tsx scripts/setup-db.ts",
    "migrate": "pnpm check-fk:static && drizzle-kit push && pnpm check-fk:db && pnpm stamp-migration",
    "stamp-migration": "tsx scripts/stamp-migration.ts",
    "check-fk": "tsx ../scripts/check-fk-delete-rules.ts",
    "check-fk:static": "tsx ../scripts/check-fk-delete-rules.ts --static",
    "check-fk:db": "tsx ../scripts/check-fk-delete-rules.ts --db"
  },
  "dependencies": {
    "@trpc/server": "^11.6.0",
    "bcryptjs": "^2.4.3",
    "cookie": "^1.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "drizzle-orm": "^0.44.5",
    "express": "^4.21.2",
    "jose": "^6.1.0",
    "nanoid": "^5.1.5",
    "pg": "^8.11.0",
    "superjson": "^1.13.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.1",
    "typescript": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@esbuild/win32-x64",
      "@esbuild/win32-ia32"
    ]
  }
}