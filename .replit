modules = ["nodejs-20", "python-3.11", "postgresql-16"]
[agent]
expertMode = true
integrations = ["github:1.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "License Center"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "server-typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "client-typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "server-recovery-lint"

[[workflows.workflow]]
name = "Backend Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd server-app && pnpm run dev"
waitForPort = 3000

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd client-app && pnpm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "License Center"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd license-center-app && pnpm run dev"
waitForPort = 8080

[[workflows.workflow]]
name = "server-typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd server-app && pnpm exec tsc --noEmit 2>&1 | head -60"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "client-typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd client-app && pnpm exec tsc --noEmit 2>&1 | head -60"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "server-recovery-lint"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd server-app && node -e \"const fs=require('fs'); const src=fs.readFileSync('src/routers/recovery.ts','utf8'); const checks=[['getSystemChannels',1],['devOnlyPayload',1],['mockSend',1],['IS_DEV',1],['SMS_PROVIDER',1],['MAX_OTP_ATTEMPTS',1],['MAX_OTP_SENDS_PER_15MIN',1]]; let failed=false; checks.forEach(([k,n])=>{ const count=(src.match(new RegExp(k,'g'))||[]).length; if(count<n){console.error('MISSING: '+k); failed=true;}else{console.log('OK: '+k+' ('+count+' occurrences)');} }); if(failed)process.exit(1); console.log('All security checks passed.');\""

[workflows.workflow.metadata]
isValidation = true

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5001
externalPort = 3002

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 23636
externalPort = 3000

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "cd server-app && pnpm run start"]
build = ["bash", "-c", "cd client-app && pnpm run build && cd ../server-app && pnpm run build && pnpm run migrate"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
