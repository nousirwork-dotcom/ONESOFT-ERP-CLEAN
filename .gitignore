# ══════════════════════════════════════════════════════════
#  OneSoft ERP — .gitignore
# ══════════════════════════════════════════════════════════

# ── Node.js dependencies ──────────────────────────────────
node_modules/
client-app/node_modules/
server-app/node_modules/
electron/node_modules/
artifacts/node_modules/

# ── Build output (regeneratable) ─────────────────────────
client-app/dist/
server-app/dist/
electron/dist/
dist-installer/
*.mjs.map

# ── Runtime logs ─────────────────────────────────────────
logs/
*.log
server-app/logs/
client-app/logs/

# ── Backup archives ───────────────────────────────────────
*.tar.gz
*.zip
*.gz
*backup*
*-backup-*
*_backup_*
# استثناء: ملفات المصدر التي تحتوي "backup" في اسمها
!server-app/src/routers/backup.ts

# ── Database ──────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db

# ── Environment & secrets ────────────────────────────────
.env
.env.local
.env.production
.env.*.local
server-app/src/.env
server-app/.env
config.json
!deploy-windows/config.json.example

# ── Replit internal (not needed for development) ─────────
.local/
.cache/
.config/
.upm/
.replit.d/
artifacts/
.canvas/
canvas/
__pycache__/
*.pyc
*.pyo
main.py
pyproject.toml

# ── Agent memory & workspace ─────────────────────────────
.agents/

# ── Development screenshots & temp images ────────────────
attached_assets/

# ── Generated public files (created on demand) ───────────
client-app/public/onesoft-update.zip
client-app/public/onesoft-erp.zip
client-app/public/*.zip

# ── pnpm ─────────────────────────────────────────────────
.pnpm-store/
.pnpm-debug.log*

# ── OS files ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ── License Keys & Signed License Files ───────────────────────────────────────
# Block ALL .pem by default, then explicitly allow the public key
*.pem
!**/public_key.pem
private_key*
scripts/keys/
license-center/keys/private*
license.dat
license.ons
test-license.ons
activation-code.txt

# ── IDE ──────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ── TypeScript ────────────────────────────────────────────
*.tsbuildinfo
