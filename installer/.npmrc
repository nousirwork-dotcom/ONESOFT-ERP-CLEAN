; pnpm node linker: hoisted = flat node_modules like npm, no symlinks.
; Required so electron-builder can correctly traverse and pack ALL
; production dependencies (including transitive deps like pg-types)
; into app.asar.
;
; Problem without this: pnpm's default node-linker=isolated uses
; symlinks in node_modules. electron-builder does not follow pnpm
; symlinks correctly → pg is packed but pg-types (transitive dep of
; pg) is missing → "Cannot find module 'pg-types'" at runtime.
node-linker=hoisted
