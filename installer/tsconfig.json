{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@core/*": ["core/*"],
      "@ui/*": ["ui/*"]
    }
  },
  "include": ["core/**/*", "ui/**/*", "electron/**/*"],
  "exclude": ["node_modules", "dist", "dist-electron"]
}
