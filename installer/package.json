{
  "name": "onesoft-installer",
  "version": "1.0.36",
  "description": "OneSoft ERP — Professional Installer",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "node scripts/build-all.mjs",
    "build:installer-only": "pnpm run build:electron && pnpm run build:preload && vite build && electron-builder --win --x64 --ia32 --config electron-builder.yml --publish=never",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --target=node20 --format=cjs --external:electron --external:pg-native --external:node-windows --external:obuf --tsconfig=tsconfig.electron.json --outfile=dist-electron/electron/main.js --log-level=warning",
    "build:preload": "esbuild electron/preload.ts --bundle --platform=node --target=node20 --format=cjs --external:electron --tsconfig=tsconfig.electron.json --outfile=dist-electron/electron/preload.js --log-level=warning",
    "build:core": "tsc -p tsconfig.core.json",
    "test:core": "tsx core/index.ts",
    "test:legacy-upgrade": "tsx scripts/test-legacy-upgrade.ts",
    "test:postgres-tools": "tsx scripts/test-postgresql-tools-resolver.ts",
    "test:upgrade-diagnostics": "tsx scripts/test-upgrade-diagnostics.ts",
    "test:atomic-upgrade": "tsx scripts/test-atomic-upgrade.ts",
    "test:cross-stage-upgrade": "tsx scripts/test-cross-stage-upgrade.ts",
    "test:upgrade-entrypoint": "tsx scripts/test-upgrade-entrypoint.ts",
    "test:in-app-upgrade-bootstrap": "tsx scripts/test-in-app-upgrade-bootstrap.ts",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "release:patch": "node scripts/bump-version.mjs patch",
    "release:minor": "node scripts/bump-version.mjs minor",
    "release:major": "node scripts/bump-version.mjs major"
  },
  "dependencies": {
    "node-windows": "^1.0.0-beta.8",
    "obuf": "^0.1.1"
  },
  "devDependencies": {
    "electron-updater": "^6.3.9",
    "esbuild": "^0.21.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.44.1",
    "pg": "^8.11.5",
    "bcryptjs": "^2.4.3",
    "archiver": "^7.0.1",
    "which": "^4.0.0",
    "semver": "^7.6.2",
    "execa": "^9.3.0",
    "fs-extra": "^11.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/archiver": "^6.0.2",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.14.2",
    "@types/pg": "^8.11.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/semver": "^7.5.8",
    "@types/which": "^3.0.3",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.0.2",
    "electron-builder": "^24.13.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.15.6",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "wait-on": "^7.2.0",
    "zustand": "^4.5.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@esbuild/win32-x64",
      "@esbuild/win32-ia32",
      "electron"
    ]
  }
}
