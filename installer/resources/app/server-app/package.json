{
  "name": "onesoft-erp-server",
  "version": "1.0.27",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs",
    "build": "node build.mjs",
    "build:dev": "node build.mjs --dev",
    "verify-build": "node scripts/verify-build.mjs",
    "pipeline": "pnpm build && pnpm verify-build",
    "setup-db": "tsx scripts/setup-db.ts",
    "migrate": "pnpm check-fk:static && tsx scripts/run-migrations.ts && pnpm check-fk:db",
    "audit:zatca-0061": "tsx scripts/audit-zatca-0061.ts",
    "audit:zatca-0061:detail": "tsx scripts/audit-zatca-0061-detail.ts",
    "test:migrations": "tsx scripts/test-migrations.ts",
    "stamp-migration": "tsx scripts/stamp-migration.ts",
    "check-fk": "tsx ../scripts/check-fk-delete-rules.ts",
    "check-fk:static": "tsx ../scripts/check-fk-delete-rules.ts --static",
    "check-fk:db": "tsx ../scripts/check-fk-delete-rules.ts --db",

    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@trpc/server": "^11.6.0",
    "@talha7k/zatca": "^0.11.1",
    "bcryptjs": "^2.4.3",
    "cookie": "^1.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "drizzle-orm": "^0.44.5",
    "express": "^4.21.2",
    "jose": "^6.1.0",
    "nanoid": "^5.1.5",
    "pg": "^8.11.0",
    "qrcode": "^1.5.4",
    "superjson": "^1.13.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.1",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@esbuild/win32-x64",
      "@esbuild/win32-ia32"
    ]
  }
}
